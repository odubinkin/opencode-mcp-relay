# Bun loads packages/cli/.env when running the CLI from this directory.
# These variables enable OAuth for `opencode mcp serve --transport http`.
# Set ALL five variables, or leave all unset for the unauthenticated local mode.
# Use your public HTTPS origin for ChatGPT, e.g. https://opencode.example.com.
# Plain HTTP is supported only on loopback for local testing.
OPENCODE_MCP_OAUTH_ISSUER=http://127.0.0.1:4096
# Copy these two values into ChatGPT's OAuth Client ID and Client Secret fields.
OPENCODE_MCP_OAUTH_CLIENT_ID=opencode-chatgpt
OPENCODE_MCP_OAUTH_CLIENT_SECRET=replace-with-a-random-secret
# Separate password entered in the browser when approving the connection.
# This is NOT your OpenCode service password or an OpenAI account password.
OPENCODE_MCP_OAUTH_PASSWORD=replace-with-a-random-password
# Comma-separated, exact redirect URIs from the ChatGPT MCP management page.
OPENCODE_MCP_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Optional token storage override. Standalone defaults to oauth-tokens.json next to --env-file.
# OPENCODE_MCP_OAUTH_TOKEN_FILE=/absolute/path/to/oauth-tokens.json
